{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    { "source": "/huma", "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }] },
    { "source": "/huma/:path*", "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }] }
  ],
  "rewrites": [
    { "source": "/css/:path*", "destination": "/css/:path*" },
    { "source": "/js/:path*", "destination": "/js/:path*" },
    { "source": "/images/:path*", "destination": "/images/:path*" },
    { "source": "/favicon.ico", "destination": "/favicon.ico" },
    { "source": "/manifest.json", "destination": "/manifest.json" },
    { "source": "/sw.js", "destination": "/sw.js" },
    { "source": "/huma", "destination": "/huma/index.html" },
    { "source": "/huma/:path*", "destination": "/huma/index.html" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
